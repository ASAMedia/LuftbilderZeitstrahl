# Copy to .env on the server and adjust.

# The image GitHub Actions publishes. Docker requires the whole reference to
# be LOWERCASE — the workflow lowercases your repo automatically, so
# ASAMedia/LuftbilderZeitstrahl is published as:
IMAGE=ghcr.io/asamedia/luftbilderzeitstrahl:latest
# (For a fork: ghcr.io/<owner-lowercased>/<repo-lowercased>:latest)

# Host port to expose the app on (container always listens on 3000).
HOST_PORT=3222

# Timezone for log timestamps.
TZ=Europe/Berlin

# Container resource caps (safety only — the server does no image processing,
# it just caches/proxies the source previews, so it's very light).
CPU_LIMIT=2             # hard cap on container CPUs (cores)
MEM_LIMIT=512m          # hard cap on container memory

# Hard cap on the on-disk preview cache (CACHE_DIR/preview) in MiB. The server
# evicts the oldest entries (by mtime, ~FIFO) once a write would put it over
# the budget, so the cache volume can never grow past this size and fill the
# host drive. The small JSON overview cache in CACHE_DIR is not counted (a
# few KB per entry). Set 0 to disable the cap.
CACHE_MAX_MB=1024       # default 1 GiB; raise if you have lots of disk to spare
