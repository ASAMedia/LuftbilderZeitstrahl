# Copy to .env on the server and adjust.

# The image GitHub Actions publishes. Replace OWNER/REPO with your GitHub
# org/user and repository name (must be lowercase for GHCR), e.g.:
#   IMAGE=ghcr.io/jane-doe/luftbilder-zeitstrahl:latest
IMAGE=ghcr.io/OWNER/luftbilder-zeitstrahl:latest

# Host port to expose the app on (container always listens on 3000).
HOST_PORT=3000

# Timezone for log timestamps.
TZ=Europe/Berlin
