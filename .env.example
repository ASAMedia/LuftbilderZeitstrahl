# Copy to .env on the server and adjust.

# The image GitHub Actions publishes. Docker requires the whole reference to
# be LOWERCASE — the workflow lowercases your repo automatically, so
# ASAMedia/LuftbilderZeitstrahl is published as:
IMAGE=ghcr.io/asamedia/luftbilderzeitstrahl:latest
# (For a fork: ghcr.io/<owner-lowercased>/<repo-lowercased>:latest)

# Host port to expose the app on (container always listens on 3000).
HOST_PORT=3222

# Timezone for log timestamps.
TZ=Europe/Berlin
